# Copie para .env e preencha com o projeto Supabase da Top Rações
# (Supabase > Project Settings > API)

# Navegador (Vite)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# API (Vercel / api/server.js)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Opcional, recomendado em produção: a API passa a usar esta chave
# (que nunca vai para o navegador) em vez da anon.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Só para rodar no computador
VITE_API_URL=/api
